{
  "name": "@mcp-apps-kit/example-weather-app",
  "version": "0.1.0",
  "private": true,
  "description": "Weather app example demonstrating file-based MCP app development with @mcp-apps-kit/codegen",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm dev:server\" \"pnpm dev:ui\"",
    "dev:server": "pnpm exec mcp-serve --watch",
    "dev:ui": "vite build --watch --config ui/vite.config.ts",
    "start": "pnpm exec mcp-serve",
    "generate": "pnpm exec mcp-codegen",
    "build": "pnpm generate && pnpm build:ui && tsc",
    "build:ui": "vite build --config ui/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mcp-apps-kit/codegen": "workspace:*",
    "@mcp-apps-kit/core": "workspace:*",
    "@mcp-apps-kit/ui": "workspace:*",
    "@mcp-apps-kit/ui-react": "workspace:*",
    "@mcp-apps-kit/ui-react-builder": "workspace:*",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@mcp-apps-kit/testing": "workspace:*",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^25.0.7",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.3.1",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^4.0.17"
  }
}
