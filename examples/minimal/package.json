{
  "name": "@mcp-apps-kit/example-minimal",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal example demonstrating basic @mcp-apps-kit/core usage with React UI",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm dev:server\" \"pnpm dev:ui\"",
    "dev:server": "tsx watch src/index.ts",
    "dev:ui": "vite build --watch",
    "start": "tsx src/index.ts",
    "build": "pnpm build:ui && tsc",
    "build:ui": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mcp-apps-kit/core": "workspace:*",
    "@mcp-apps-kit/ui": "workspace:*",
    "@mcp-apps-kit/ui-react": "workspace:*",
    "@mcp-apps-kit/ui-react-builder": "workspace:*",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@mcp-apps-kit/testing": "workspace:*",
    "dotenv": "^17.3.1",
    "openai": "^6.27.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.4.0",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "concurrently": "^9.2.1",
    "fast-check": "^4.6.0",
    "jsdom": "^27.4.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.3.1",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^4.0.18"
  }
}
