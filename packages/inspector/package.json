{
  "name": "@mcp-apps-kit/inspector",
  "version": "0.5.0",
  "description": "MCP Inspector Server - Test and debug MCP servers through any MCP client",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mcp-inspector": "./dist/bin/mcp-inspector.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": {
        "default": "./dist/index.js"
      },
      "require": {
        "default": "./dist/index.cjs"
      }
    },
    "./dashboard/react": {
      "types": "./dist/dashboard/react/index.d.ts",
      "import": {
        "default": "./dist/dashboard/react/index.js"
      },
      "require": {
        "default": "./dist/dashboard/react/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm build:dashboard && tsup",
    "build:dashboard": "vite build",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "inspector",
    "testing",
    "debugging"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndurilCode/mcp-apps-kit.git",
    "directory": "packages/inspector"
  },
  "dependencies": {
    "@mcp-apps-kit/core": "workspace:*",
    "@mcp-apps-kit/testing": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "jsdom": "^27.0.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^7.3.1",
    "vite-plugin-singlefile": "^2.3.2"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "playwright": "^1.50.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "sideEffects": false
}
