{
  "name": "@mcp-apps-kit/inspector",
  "version": "0.5.0",
  "description": "MCP Inspector Server - Test and debug MCP servers through any MCP client",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mcp-inspector": "./dist/bin/mcp-inspector.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": {
        "default": "./dist/index.js"
      },
      "require": {
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "inspector",
    "testing",
    "debugging"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndurilCode/mcp-apps-kit.git",
    "directory": "packages/inspector"
  },
  "dependencies": {
    "@mcp-apps-kit/core": "workspace:*",
    "@mcp-apps-kit/testing": "workspace:*",
    "jsdom": "^27.0.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7"
  },
  "optionalDependencies": {
    "playwright": "^1.50.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false
}
